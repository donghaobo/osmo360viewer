<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:gravity="center"
        android:textColor="#BBBBBF"
        android:textSize="13sp"
        android:text="正在准备解码器…" />

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#7A000000"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="start"
            android:textColor="#F1F1F4"
            android:textSize="13sp"
            android:text="OSV" />

        <TextView
            android:id="@+id/btn_sensor"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="52dp"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:background="@drawable/pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="体感"
            android:textColor="#DDDDE3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_mode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="52dp"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:background="@drawable/pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="全景"
            android:textColor="#DDDDE3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_panel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:background="@drawable/pill"
            android:text="⚙"
            android:textColor="#DDDDE3"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="62dp"
        android:layout_marginStart="12dp"
        android:background="#5A000000"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:fontFamily="monospace"
        android:textColor="#B9B9C4"
        android:textSize="10.5sp"
        android:lineSpacingExtra="2dp"
        android:text="—" />

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#7A000000"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btn_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:max="1000"
            android:progressTint="#2C6CF5"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="end"
            android:fontFamily="monospace"
            android:text="0:00 / 0:00"
            android:textColor="#C5C5CE"
            android:textSize="11.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stab_panel"
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="86dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="稳像调参（长按「稳像」关闭）"
            android:textColor="#B9B9C4"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="姿态延时"
            android:textColor="#B9B9C4"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sk_stab_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="400"
            android:progress="200"
            android:progressTint="#2C6CF5"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/lb_stab_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0 ms"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="补偿强度"
            android:textColor="#B9B9C4"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sk_stab_gain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:progressTint="#2C6CF5"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/lb_stab_gain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="平滑系数（100 = 不平滑）"
            android:textColor="#B9B9C4"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sk_stab_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:progressTint="#2C6CF5"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/lb_stab_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_stab_source"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:text="时刻源：显示帧"
            android:textColor="#E6E6EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_stab_reset"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:text="恢复默认"
            android:textColor="#B9B9C4"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="236dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="接缝羽化"
            android:textColor="#B9B9C4"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sk_feather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="120"
            android:progress="40"
            android:progressTint="#2C6CF5"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/lb_feather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="4.0°"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="接缝偏移"
            android:textColor="#B9B9C4"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sk_seam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="400"
            android:progress="200"
            android:progressTint="#2C6CF5"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/lb_seam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="+0.0°"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="极点硬边"
            android:textColor="#B9B9C4"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sk_pole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="#2C6CF5"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/lb_pole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="关"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_loop"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:background="@drawable/pill"
            android:text="循环播放 ✓"
            android:textColor="#E6E6EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_log"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:background="@drawable/pill"
            android:text="导出日志"
            android:textColor="#B9B9C4"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_level"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:background="@drawable/pill"
            android:text="自动水平"
            android:textColor="#E6E6EA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:background="@drawable/pill"
            android:text="重置视角"
            android:textColor="#E6E6EA"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
